# npm run dev supplies a persistent project-local MongoDB replica set.
# For an external MongoDB replica set / Atlas, set URI and use npm run dev:external.
MONGODB_URI=mongodb://127.0.0.1:27027/techdesk?replicaSet=techdesk-dev
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_URL=http://localhost:3000
# Local fictional accounts only. Required by the seed command; never used by login directly.
DEMO_PASSWORD=replace-with-a-local-demo-password
