# Copy the values into .env.local privately; do not commit real credentials.
# Percent-encode reserved characters in the database username and password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.hdfssqu.mongodb.net/techdesk?appName=Cluster0
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Needed only for an explicitly initialized fictional demo, never for normal login.
DEMO_PASSWORD=replace-with-a-local-demo-password
